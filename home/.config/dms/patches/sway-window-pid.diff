+// Sway and Scroll expose no PID on foreign toplevels; match the get_tree node by app ID and title
+function swayWindowPid(tree, toplevel, screenName) {
+    if (!tree || !toplevel)
+        return 0;
+    const appId = toplevel.appId || "";
+    const title = toplevel.title || "";
+    const matches = [];
+    const visit = (node, output) => {
+        if (node.type === "output")
+            output = node.name;
+        if (node.pid > 0 && (node.app_id || node.window_properties?.class || "") === appId && (node.name || "") === title)
+            matches.push({ node, output });
+        for (const child of node.nodes || [])
+            visit(child, output);
+        for (const child of node.floating_nodes || [])
+            visit(child, output);
+    };
+    visit(tree, "");
+    const match = matches.find(m => m.node.focused) || matches.find(m => m.node.visible && m.output === screenName) || (matches.length === 1 ? matches[0] : null);
+    return match?.node.pid || 0;
+}
